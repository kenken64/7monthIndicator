BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram Rate Limiting (OPTIONAL)
# Minimum minutes between telegram notifications to prevent flooding
# Default: 5 minutes. Set to 0 to disable rate limiting (not recommended)
TELEGRAM_COOLDOWN_MINUTES=5

# Bot Control PIN Protection (REQUIRED)
# Set a 6-digit PIN for bot pause/resume control
# Example: 123456 (CHANGE THIS!)
BOT_CONTROL_PIN=123456

# LLM Provider Configuration (REQUIRED for Chart Analysis Bot & AI Features)
# Choose your LLM provider: "openai" or "deepseek" (default: openai)
LLM_PROVIDER=openai

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Used for AI-powered chart analysis and trading recommendations
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Configuration (Alternative to OpenAI)
# Get your API key from: https://platform.deepseek.com/api_keys
# DeepSeek offers cost-effective AI models compatible with OpenAI format
DEEPSEEK_API_KEY=your_deepseek_api_key_here