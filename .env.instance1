# Instance 1 Configuration - OpenAI Provider
# This instance uses OpenAI for full feature support including vision

# LLM Provider Configuration
LLM_PROVIDER=openai

# OpenAI API Key (for instance 1)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (backup)
DEEPSEEK_API_KEY=sk-ae71a640f1344a5e9f13b34d69090c0b

# Instance Settings
INSTANCE_ID=1
FLASK_PORT=5000
TRADING_SYMBOL=SUIUSDC

# Feature Flags
USE_LOCAL_SENTIMENT=false
REDUCE_API_CALLS=true

# Cache Settings
SENTIMENT_CACHE_HOURS=24

# Note: Sensitive credentials (API keys, tokens, PINs) are also managed via Docker secrets
# See docker-compose.yml for secrets configuration
