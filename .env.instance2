# Instance 2 Configuration - DeepSeek Provider
# This instance uses DeepSeek for cost-effective operations

# LLM Provider Configuration
LLM_PROVIDER=deepseek

# DeepSeek API Key (for instance 2)
DEEPSEEK_API_KEY=sk-ae71a640f1344a5e9f13b34d69090c0b

# OpenAI API Key (not used for instance 2 - using DeepSeek only)
# OPENAI_API_KEY=your_openai_api_key_here

# Instance Settings
INSTANCE_ID=2
FLASK_PORT=5001
TRADING_SYMBOL=SUIUSDT

# Telegram Notifications (disabled for instance 2 to prevent flooding)
# Notifications are handled by instance 1 only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature Flags
USE_LOCAL_SENTIMENT=false
REDUCE_API_CALLS=true
ENABLE_MARKET_CONTEXT=true
ENABLE_NEWS_SENTIMENT=false

# Cache Settings
SENTIMENT_CACHE_HOURS=24

# Note: Sensitive credentials (API keys, tokens, PINs) are also managed via Docker secrets
# See docker-compose.multi-instance.yml for secrets configuration
